{
  "name": "@aerobeat/web-gameplay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "src/",
    "README.md",
    "LICENSE.md",
    "docs/decisions/"
  ],
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "check": "npm run check:jsdoc && npm run check:imports && npm run check:components && npm run check:console",
    "check:jsdoc": "node scripts/validate-jsdoc-no-any.js",
    "check:imports": "node scripts/validate-public-imports.js",
    "check:components": "node scripts/validate-component-rules.js",
    "check:console": "node scripts/validate-playwright-console-noise.js",
    "test": "npm run check && npm run test:unit",
    "test:unit": "node scripts/validate-gameplay-session.js",
    "test:browser": "npm run check:console && node scripts/validate-browser-session.js",
    "demo": "npm --prefix .testbed run demo",
    "testbed:serve": "npm --prefix .testbed run serve",
    "testbed:link-self": "node scripts/link-testbed-self.js"
  },
  "peerDependencies": {
    "@aerobeat/web-audio": "^0.1.0",
    "@aerobeat/web-content": "^0.1.0",
    "@aerobeat/web-contracts": "^0.1.0",
    "@aerobeat/web-input": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@aerobeat/web-audio": { "optional": true },
    "@aerobeat/web-content": { "optional": true },
    "@aerobeat/web-input": { "optional": true }
  },
  "devDependencies": {
    "@aerobeat/web-contracts": "file:../aerobeat-web-contracts",
    "playwright": "^1.55.0"
  }
}
